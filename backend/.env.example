# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- MongoDB ---
# Local:  mongodb://localhost:27017/financeiro
# Atlas:  mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/financeiro?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/financeiro

# --- CORS ---
# Origem(ns) do front-end permitida(s), separadas por vírgula.
CORS_ORIGIN=http://localhost:5173

# --- Upload ---
# Tamanho máximo de arquivo de importação, em MB.
MAX_UPLOAD_MB=10
